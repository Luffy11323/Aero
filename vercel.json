{
  "version": 2,
  "functions": {
    "api/flights.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "cv-segregation.akatechsolution.com" }
      ],
      "destination": "https://aero-woad.vercel.app/cvs.html",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "emailblast.akatechsolution.com" }
      ],
      "destination": "https://frnklnwrld-emailblast-pro.hf.space/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "savenest.akatechsolution.com" }
      ],
      "destination": "https://frnklnwrld-savenest-api.hf.space/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "bot.akatechsolution.com" }
      ],
      "destination": "https://frnklnwrld-me.hf.space/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "flightsapi.akatechsolution.com" }
